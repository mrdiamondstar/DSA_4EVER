class TreeNode:
    def __init__(self,val=0,left=None, right=0):
        self.val=val
        self.left=left
        self.right=right

class Solution:
    def dfs(self,root:optional[TreeNode])->List[List[]]:
        
        result=[]

        def preorder(root):
            if not root:
                return 

            result.append(root.val)
            preorder(root.left)
            preorder(root.right)
            
        preorder(root)
        return result

root=TreeNode(1)
root.left=TreeNode(2)
root.right=TreeNode(3)
root.left.left=TreeNode(4)
root.left.right=TreeNode(5)
root.right.left=TreeNode(6)
root.right.right= TreeNode(7)

obj=Solution

result=obj.dfs(root)

print(result)


            
            